# Опционально: бесплатные ключи для ИИ-проверки правил резолва (бот работает и без них)
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# NVIDIA NIM (опциональный fallback): https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
NVIDIA_NATIVE_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Опционально: Telegram-уведомления о сделках
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Настройки paper-trading
INITIAL_BANKROLL=1000.0
KELLY_FRACTION=0.25
MIN_EDGE=0.06
SLIPPAGE_BUFFER=0.005
DB_PATH=data/paper_trader.db
